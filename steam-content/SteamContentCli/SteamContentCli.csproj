<Project Sdk="Microsoft.NET.Sdk">
  <!-- RAL 用的 Steam 内容下载宿主：由游戏安装流程调用，stdout 按行输出 JSON 进度 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SteamContentCli</AssemblyName>
    <RootNamespace>SteamContentCli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 这台设备上 Roslyn 编译服务器偶发 SIGSEGV（139），改用进程内编译 -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TmlAndroidContent/TmlAndroidContent.csproj" />
  </ItemGroup>
</Project>
